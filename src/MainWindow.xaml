<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NEXUS · Ports PC" Width="1180" Height="820" MinWidth="820" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#101115" Foreground="#EFF2F8" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#B4F176"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EFF2F8"/><Setter Property="Background" Value="#282C35"/><Setter Property="BorderBrush" Value="#424752"/><Setter Property="Padding" Value="17,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#B4F176"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#B4F176"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#1D2027"/><Setter Property="Foreground" Value="#EFF2F8"/><Setter Property="BorderBrush" Value="#424752"/><Setter Property="Padding" Value="11,9"/><Setter Property="CaretBrush" Value="#B4F176"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DCE0E8"/><Setter Property="Margin" Value="0,10,0,10"/></Style>
    <Style TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/></Style>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Background" Value="#15171C"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#4B5260" CornerRadius="5" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid>
    <Image x:Name="Backdrop" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0.85"/>
    <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F8101115" Offset="0"/><GradientStop Color="#C0101115" Offset="0.4"/><GradientStop Color="#35101115" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
    <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#30101115" Offset="0"/><GradientStop Color="#20101115" Offset="0.25"/><GradientStop Color="#ED101115" Offset="0.70"/><GradientStop Color="#FF101115" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Padding="28,20" Background="#A0101115" BorderBrush="#25FFFFFF" BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="False">
          <StackPanel Orientation="Horizontal"><TextBlock Text="◈" Foreground="{StaticResource Accent}" FontSize="29" Margin="0,0,11,0" VerticalAlignment="Center"/><TextBlock Text="N E X U S" FontWeight="SemiBold" FontSize="21" VerticalAlignment="Center"/><TextBlock Text="/   PORTS PC" Foreground="#9CA5B5" FontSize="12" Margin="24,0,0,0" VerticalAlignment="Center"/></StackPanel>
          <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="Configurações" Margin="8,0,0,0"/>
          <Button x:Name="DetectButton" DockPanel.Dock="Right" Content="Detectar ports"/>
        </DockPanel>
      </Border>
      <ScrollViewer Grid.Row="1">
        <StackPanel>
          <Grid MinHeight="320" Margin="36,25,36,15">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="660">
              <TextBlock Text="SUA BIBLIOTECA. SEU UNIVERSO." FontSize="11" Foreground="{StaticResource Accent}" Margin="0,0,0,20"/>
              <TextBlock x:Name="HeroTitle" Text="Seu próximo universo" FontSize="47" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,13"/>
              <TextBlock x:Name="HeroDescription" Text="Adicione seus ports e reúna suas aventuras em um só lugar." Foreground="#BCC4D1" FontSize="15" TextWrapping="Wrap" MaxWidth="470" HorizontalAlignment="Left" Margin="0,0,0,21"/>
              <WrapPanel><Button x:Name="PlayButton" Content="▶   Jogar" Background="{StaticResource Accent}" Foreground="#15200E" BorderBrush="{StaticResource Accent}" FontWeight="SemiBold" Padding="30,13"/><Button x:Name="EditButton" Content="Configurar jogo"/><Button x:Name="FavoriteButton" Content="☆ Favoritar"/></WrapPanel>
              <TextBlock x:Name="HeroMeta" Foreground="#A5AEBC" FontSize="12" Margin="0,15,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
          <Border Background="#A0101115" Padding="30,20,30,25">
            <StackPanel>
              <DockPanel Margin="0,0,0,20" LastChildFill="False">
                <StackPanel Orientation="Horizontal"><TextBlock Text="Sua coleção" FontSize="20" VerticalAlignment="Center"/><TextBlock x:Name="CountLabel" Foreground="#9BA4B4" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                <Button x:Name="AddButton" Content="＋ Adicionar jogo" DockPanel.Dock="Right" Margin="12,0,0,0"/>
                <Grid Width="210" DockPanel.Dock="Right"><TextBox x:Name="SearchBox" ToolTip="Buscar na sua coleção" AutomationProperties.Name="Buscar na coleção"/><TextBlock Text="Buscar na coleção…" Foreground="#959FAF" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
              </DockPanel>
              <CheckBox x:Name="FavoritesOnly" Content="Mostrar apenas favoritos" Margin="0,0,0,17"/>
              <WrapPanel x:Name="GameGrid"/>
              <TextBlock x:Name="EmptyLabel" Text="Sua coleção começa aqui. Adicione um executável ou detecte ports na pasta Downloads." Foreground="#AAB3C2" TextWrapping="Wrap" Margin="0,20,0,30"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Background="#101115" BorderBrush="#282C34" BorderThickness="0,1,0,0" Padding="24,12"><DockPanel><TextBlock Text="●  Biblioteca local" Foreground="#B4F176" FontSize="11" DockPanel.Dock="Right"/><TextBlock x:Name="StatusLabel" Text="Pronto" Foreground="#A3ACBC" FontSize="12" TextWrapping="Wrap"/></DockPanel></Border>
    </Grid>
  </Grid>
</Window>
